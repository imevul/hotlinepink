{
  "name": "Hotline Pink",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "{{text}}",
    "descriptionForeground": "{{muted}}",
    "errorForeground": "{{error}}",
    "focusBorder": "{{cyan}}",
    "selection.background": "{{border}}",
    "textLink.foreground": "{{highlight}}",
    "textLink.activeForeground": "{{primary}}",
    "editor.background": "{{bg}}",
    "editor.foreground": "{{text}}",
    "editorCursor.foreground": "{{cursor}}",
    "editor.lineHighlightBackground": "{{surface}}",
    "editor.selectionBackground": "{{border}}",
    "editor.findMatchBackground": "{{deep}}",
    "editor.findMatchHighlightBackground": "{{border}}",
    "editorLineNumber.foreground": "{{index}}",
    "editorLineNumber.activeForeground": "{{primary}}",
    "editorIndentGuide.background1": "{{border-soft}}",
    "editorIndentGuide.activeBackground1": "{{border}}",
    "editorBracketMatch.background": "{{raised}}",
    "editorBracketMatch.border": "{{primary}}",
    "editorBracketHighlight.foreground1": "{{muted}}",
    "editorBracketHighlight.foreground2": "{{highlight}}",
    "editorBracketHighlight.foreground3": "{{cyan}}",
    "editorBracketHighlight.foreground4": "{{muted}}",
    "editorBracketHighlight.foreground5": "{{highlight}}",
    "editorBracketHighlight.foreground6": "{{cyan}}",
    "editorBracketHighlight.unexpectedBracket.foreground": "{{error}}",
    "editorError.foreground": "{{error}}",
    "editorWarning.foreground": "{{warning}}",
    "editorInfo.foreground": "{{cyan}}",
    "editorGutter.addedBackground": "{{success}}",
    "editorGutter.modifiedBackground": "{{warning}}",
    "editorGutter.deletedBackground": "{{error}}",
    "editorGroupHeader.tabsBackground": "{{surface}}",
    "editorWidget.background": "{{surface}}",
    "editorWidget.border": "{{border}}",
    "editorSuggestWidget.background": "{{surface}}",
    "editorSuggestWidget.selectedBackground": "{{raised}}",
    "editorSuggestWidget.highlightForeground": "{{primary}}",
    "diffEditor.insertedTextBackground": "{{diff-add-bg}}",
    "diffEditor.removedTextBackground": "{{diff-del-bg}}",
    "activityBar.background": "{{bg}}",
    "activityBar.foreground": "{{primary}}",
    "activityBar.inactiveForeground": "{{index}}",
    "activityBar.border": "{{border-soft}}",
    "activityBarBadge.background": "{{primary}}",
    "activityBarBadge.foreground": "{{bg}}",
    "sideBar.background": "{{surface}}",
    "sideBar.foreground": "{{muted}}",
    "sideBar.border": "{{border-soft}}",
    "sideBarTitle.foreground": "{{text}}",
    "sideBarSectionHeader.background": "{{surface}}",
    "sideBarSectionHeader.foreground": "{{primary}}",
    "list.activeSelectionBackground": "{{raised}}",
    "list.activeSelectionForeground": "{{text}}",
    "list.inactiveSelectionBackground": "{{raised}}",
    "list.hoverBackground": "{{raised}}",
    "list.highlightForeground": "{{primary}}",
    "tab.activeBackground": "{{bg}}",
    "tab.activeForeground": "{{text}}",
    "tab.activeBorderTop": "{{primary}}",
    "tab.inactiveBackground": "{{surface}}",
    "tab.inactiveForeground": "{{muted}}",
    "tab.border": "{{border-soft}}",
    "titleBar.activeBackground": "{{bg}}",
    "titleBar.activeForeground": "{{text}}",
    "titleBar.inactiveBackground": "{{bg}}",
    "titleBar.inactiveForeground": "{{index}}",
    "titleBar.border": "{{border-soft}}",
    "statusBar.background": "{{bg}}",
    "statusBar.foreground": "{{muted}}",
    "statusBar.border": "{{border-soft}}",
    "statusBar.noFolderBackground": "{{bg}}",
    "statusBar.debuggingBackground": "{{deep}}",
    "statusBar.debuggingForeground": "{{text}}",
    "statusBarItem.remoteBackground": "{{primary}}",
    "statusBarItem.remoteForeground": "{{bg}}",
    "panel.background": "{{bg}}",
    "panel.border": "{{border-soft}}",
    "panelTitle.activeForeground": "{{text}}",
    "panelTitle.activeBorder": "{{primary}}",
    "panelTitle.inactiveForeground": "{{muted}}",
    "button.background": "{{primary}}",
    "button.foreground": "{{bg}}",
    "button.hoverBackground": "{{highlight}}",
    "badge.background": "{{primary}}",
    "badge.foreground": "{{bg}}",
    "input.background": "{{surface}}",
    "input.foreground": "{{text}}",
    "input.border": "{{border}}",
    "input.placeholderForeground": "{{index}}",
    "dropdown.background": "{{surface}}",
    "dropdown.border": "{{border}}",
    "progressBar.background": "{{primary}}",
    "gitDecoration.addedResourceForeground": "{{success}}",
    "gitDecoration.modifiedResourceForeground": "{{warning}}",
    "gitDecoration.deletedResourceForeground": "{{error}}",
    "gitDecoration.untrackedResourceForeground": "{{cyan}}",
    "gitDecoration.ignoredResourceForeground": "{{index}}",
    "terminal.background": "{{bg}}",
    "terminal.foreground": "{{text}}",
    "terminalCursor.foreground": "{{cursor}}",
    "terminal.selectionBackground": "{{selection-bg}}",
    "terminal.ansiBlack": "{{ansi-black}}",
    "terminal.ansiRed": "{{ansi-red}}",
    "terminal.ansiGreen": "{{ansi-green}}",
    "terminal.ansiYellow": "{{ansi-yellow}}",
    "terminal.ansiBlue": "{{ansi-blue}}",
    "terminal.ansiMagenta": "{{ansi-magenta}}",
    "terminal.ansiCyan": "{{ansi-cyan}}",
    "terminal.ansiWhite": "{{ansi-white}}",
    "terminal.ansiBrightBlack": "{{ansi-bright-black}}",
    "terminal.ansiBrightRed": "{{ansi-bright-red}}",
    "terminal.ansiBrightGreen": "{{ansi-bright-green}}",
    "terminal.ansiBrightYellow": "{{ansi-bright-yellow}}",
    "terminal.ansiBrightBlue": "{{ansi-bright-blue}}",
    "terminal.ansiBrightMagenta": "{{ansi-bright-magenta}}",
    "terminal.ansiBrightCyan": "{{ansi-bright-cyan}}",
    "terminal.ansiBrightWhite": "{{ansi-bright-white}}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{syntax-comment}}" } },
    { "scope": ["keyword", "storage", "storage.modifier", "keyword.control"], "settings": { "foreground": "{{syntax-keyword}}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "{{syntax-function}}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "storage.type"], "settings": { "foreground": "{{syntax-type}}" } },
    { "scope": ["storage.type.function", "storage.type.class", "storage.type.struct", "storage.type.interface", "storage.type.enum"], "settings": { "foreground": "{{syntax-keyword}}" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "{{syntax-string}}" } },
    { "scope": ["constant", "constant.numeric", "constant.language"], "settings": { "foreground": "{{syntax-number}}" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "{{syntax-variable}}" } },
    { "scope": ["punctuation", "keyword.operator"], "settings": { "foreground": "{{muted}}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "{{syntax-keyword}}" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "{{syntax-function}}" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "{{primary}}", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "{{highlight}}" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "{{success}}" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "{{error}}" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "{{warning}}" } },
    { "scope": ["invalid"], "settings": { "foreground": "{{error}}" } }
  ]
}
