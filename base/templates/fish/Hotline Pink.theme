# name: Hotline Pink

[dark]
# preferred_background: {{bg.bare}}
fish_color_normal {{text.bare}}
fish_color_autosuggestion {{index.bare}}
fish_color_cancel -r
fish_color_command {{primary.bare}}
fish_color_comment {{index.bare}}
fish_color_cwd {{primary.bare}}
fish_color_cwd_root {{error.bare}}
fish_color_end {{muted.bare}}
fish_color_error {{error.bare}}
fish_color_escape {{cyan.bare}}
fish_color_history_current --bold
fish_color_host {{muted.bare}}
fish_color_host_remote {{cyan.bare}}
fish_color_keyword {{primary.bare}}
fish_color_operator {{highlight.bare}}
fish_color_option {{muted.bare}}
fish_color_param {{text.bare}}
fish_color_quote {{bright-green.bare}}
fish_color_redirection {{highlight.bare}}
fish_color_search_match --background={{border.bare}}
fish_color_selection --background={{border.bare}}
fish_color_status {{error.bare}}
fish_color_user {{muted.bare}}
fish_color_valid_path --underline
fish_pager_color_completion {{text.bare}}
fish_pager_color_description {{muted.bare}}
fish_pager_color_prefix {{primary.bare}} --bold
fish_pager_color_progress {{bg.bare}} --background={{primary.bare}}
fish_pager_color_selected_background --background={{border.bare}}
