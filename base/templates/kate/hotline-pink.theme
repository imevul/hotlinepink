{
  "metadata": {
    "name": "Hotline Pink",
    "revision": 1,
    "license": "SPDX-License-Identifier: MIT"
  },
  "custom-styles": {
    "Markdown": {
      "Header H1": { "text-color": "{{primary}}", "selected-text-color": "{{selection-fg}}", "bold": true },
      "Header H2": { "text-color": "{{primary}}", "selected-text-color": "{{selection-fg}}", "bold": true },
      "Header H3": { "text-color": "{{primary}}", "selected-text-color": "{{selection-fg}}", "bold": true },
      "Header H4": { "text-color": "{{primary}}", "selected-text-color": "{{selection-fg}}", "bold": true },
      "Header H5": { "text-color": "{{primary}}", "selected-text-color": "{{selection-fg}}", "bold": true },
      "Header H6": { "text-color": "{{primary}}", "selected-text-color": "{{selection-fg}}", "bold": true },
      "Inline Image": { "text-color": "{{highlight}}", "selected-text-color": "{{selection-fg}}" },
      "Reference Image": { "text-color": "{{highlight}}", "selected-text-color": "{{selection-fg}}" },
      "Inline Image: Link": { "text-color": "{{highlight}}", "selected-text-color": "{{selection-fg}}" }
    }
  },
  "editor-colors": {
    "BackgroundColor": "{{bg}}",
    "BracketMatching": "{{border}}",
    "CodeFolding": "{{raised}}",
    "CurrentLine": "{{surface}}",
    "CurrentLineNumber": "{{primary}}",
    "IconBorder": "{{bg}}",
    "IndentationLine": "{{border-soft}}",
    "LineNumbers": "{{index}}",
    "MarkBookmark": "{{highlight}}",
    "MarkBreakpointActive": "{{error}}",
    "MarkBreakpointDisabled": "{{index}}",
    "MarkBreakpointReached": "{{warning}}",
    "MarkError": "{{error}}",
    "MarkExecution": "{{cyan}}",
    "MarkWarning": "{{warning}}",
    "ModifiedLines": "{{warning}}",
    "ReplaceHighlight": "{{diff-add-bg}}",
    "SavedLines": "{{success}}",
    "SearchHighlight": "{{deep}}",
    "Separator": "{{border}}",
    "SpellChecking": "{{error}}",
    "TabMarker": "{{border}}",
    "TemplateBackground": "{{surface}}",
    "TemplateFocusedPlaceholder": "{{border}}",
    "TemplatePlaceholder": "{{raised}}",
    "TemplateReadOnlyPlaceholder": "{{surface}}",
    "TextSelection": "{{selection-bg}}",
    "WordWrapMarker": "{{border}}"
  },
  "text-styles": {
    "Normal": { "text-color": "{{syntax-variable}}", "selected-text-color": "{{selection-fg}}" },
    "Keyword": { "text-color": "{{syntax-keyword}}", "selected-text-color": "{{selection-fg}}" },
    "ControlFlow": { "text-color": "{{syntax-keyword}}", "selected-text-color": "{{selection-fg}}" },
    "Function": { "text-color": "{{syntax-function}}", "selected-text-color": "{{selection-fg}}" },
    "Variable": { "text-color": "{{syntax-variable}}", "selected-text-color": "{{selection-fg}}" },
    "Operator": { "text-color": "{{muted}}", "selected-text-color": "{{selection-fg}}" },
    "BuiltIn": { "text-color": "{{syntax-function}}", "selected-text-color": "{{selection-fg}}" },
    "Extension": { "text-color": "{{syntax-function}}", "selected-text-color": "{{selection-fg}}" },
    "Preprocessor": { "text-color": "{{highlight}}", "selected-text-color": "{{selection-fg}}" },
    "Attribute": { "text-color": "{{syntax-function}}", "selected-text-color": "{{selection-fg}}" },
    "DataType": { "text-color": "{{syntax-type}}", "selected-text-color": "{{selection-fg}}" },
    "Char": { "text-color": "{{syntax-string}}", "selected-text-color": "{{selection-fg}}" },
    "SpecialChar": { "text-color": "{{cyan}}", "selected-text-color": "{{selection-fg}}" },
    "String": { "text-color": "{{syntax-string}}", "selected-text-color": "{{selection-fg}}" },
    "VerbatimString": { "text-color": "{{syntax-string}}", "selected-text-color": "{{selection-fg}}" },
    "SpecialString": { "text-color": "{{syntax-string}}", "selected-text-color": "{{selection-fg}}" },
    "Import": { "text-color": "{{syntax-keyword}}", "selected-text-color": "{{selection-fg}}" },
    "DecVal": { "text-color": "{{syntax-number}}", "selected-text-color": "{{selection-fg}}" },
    "BaseN": { "text-color": "{{syntax-number}}", "selected-text-color": "{{selection-fg}}" },
    "Float": { "text-color": "{{syntax-number}}", "selected-text-color": "{{selection-fg}}" },
    "Constant": { "text-color": "{{syntax-number}}", "selected-text-color": "{{selection-fg}}" },
    "Comment": { "text-color": "{{syntax-comment}}", "selected-text-color": "{{muted}}" },
    "Documentation": { "text-color": "{{syntax-comment}}", "selected-text-color": "{{muted}}" },
    "Annotation": { "text-color": "{{highlight}}", "selected-text-color": "{{selection-fg}}" },
    "CommentVar": { "text-color": "{{highlight}}", "selected-text-color": "{{selection-fg}}" },
    "RegionMarker": { "text-color": "{{index}}", "selected-text-color": "{{muted}}" },
    "Information": { "text-color": "{{cyan}}", "selected-text-color": "{{selection-fg}}" },
    "Warning": { "text-color": "{{warning}}", "selected-text-color": "{{selection-fg}}" },
    "Alert": { "text-color": "{{error}}", "selected-text-color": "{{selection-fg}}", "bold": true },
    "Error": { "text-color": "{{error}}", "selected-text-color": "{{selection-fg}}", "underline": true },
    "Others": { "text-color": "{{muted}}", "selected-text-color": "{{selection-fg}}" }
  }
}
