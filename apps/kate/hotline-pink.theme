{
  "metadata": {
    "name": "Hotline Pink",
    "revision": 1,
    "license": "SPDX-License-Identifier: MIT"
  },
  "editor-colors": {
    "BackgroundColor": "#09090B",
    "BracketMatching": "#49313E",
    "CodeFolding": "#1C191C",
    "CurrentLine": "#121214",
    "CurrentLineNumber": "#FF1493",
    "IconBorder": "#09090B",
    "IndentationLine": "#2A1F26",
    "LineNumbers": "#8E7985",
    "MarkBookmark": "#FF5CB8",
    "MarkBreakpointActive": "#EF4444",
    "MarkBreakpointDisabled": "#8E7985",
    "MarkBreakpointReached": "#F59E0B",
    "MarkError": "#EF4444",
    "MarkExecution": "#2DE2E6",
    "MarkWarning": "#F59E0B",
    "ModifiedLines": "#F59E0B",
    "ReplaceHighlight": "#12261A",
    "SavedLines": "#22C55E",
    "SearchHighlight": "#C6006F",
    "Separator": "#49313E",
    "SpellChecking": "#EF4444",
    "TabMarker": "#49313E",
    "TemplateBackground": "#121214",
    "TemplateFocusedPlaceholder": "#49313E",
    "TemplatePlaceholder": "#1C191C",
    "TemplateReadOnlyPlaceholder": "#121214",
    "TextSelection": "#49313E",
    "WordWrapMarker": "#49313E"
  },
  "text-styles": {
    "Normal": { "text-color": "#FFF4FA", "selected-text-color": "#FFF4FA" },
    "Keyword": { "text-color": "#FF1493", "selected-text-color": "#FFF4FA" },
    "ControlFlow": { "text-color": "#FF1493", "selected-text-color": "#FFF4FA" },
    "Function": { "text-color": "#FF5CB8", "selected-text-color": "#FFF4FA" },
    "Variable": { "text-color": "#FFF4FA", "selected-text-color": "#FFF4FA" },
    "Operator": { "text-color": "#B8AAB2", "selected-text-color": "#FFF4FA" },
    "BuiltIn": { "text-color": "#FF5CB8", "selected-text-color": "#FFF4FA" },
    "Extension": { "text-color": "#FF5CB8", "selected-text-color": "#FFF4FA" },
    "Preprocessor": { "text-color": "#FF5CB8", "selected-text-color": "#FFF4FA" },
    "Attribute": { "text-color": "#FF5CB8", "selected-text-color": "#FFF4FA" },
    "DataType": { "text-color": "#2DE2E6", "selected-text-color": "#FFF4FA" },
    "Char": { "text-color": "#4ADE80", "selected-text-color": "#FFF4FA" },
    "SpecialChar": { "text-color": "#2DE2E6", "selected-text-color": "#FFF4FA" },
    "String": { "text-color": "#4ADE80", "selected-text-color": "#FFF4FA" },
    "VerbatimString": { "text-color": "#4ADE80", "selected-text-color": "#FFF4FA" },
    "SpecialString": { "text-color": "#4ADE80", "selected-text-color": "#FFF4FA" },
    "Import": { "text-color": "#FF1493", "selected-text-color": "#FFF4FA" },
    "DecVal": { "text-color": "#F59E0B", "selected-text-color": "#FFF4FA" },
    "BaseN": { "text-color": "#F59E0B", "selected-text-color": "#FFF4FA" },
    "Float": { "text-color": "#F59E0B", "selected-text-color": "#FFF4FA" },
    "Constant": { "text-color": "#F59E0B", "selected-text-color": "#FFF4FA" },
    "Comment": { "text-color": "#8E7985", "selected-text-color": "#B8AAB2" },
    "Documentation": { "text-color": "#8E7985", "selected-text-color": "#B8AAB2" },
    "Annotation": { "text-color": "#FF5CB8", "selected-text-color": "#FFF4FA" },
    "CommentVar": { "text-color": "#FF5CB8", "selected-text-color": "#FFF4FA" },
    "RegionMarker": { "text-color": "#8E7985", "selected-text-color": "#B8AAB2" },
    "Information": { "text-color": "#2DE2E6", "selected-text-color": "#FFF4FA" },
    "Warning": { "text-color": "#F59E0B", "selected-text-color": "#FFF4FA" },
    "Alert": { "text-color": "#EF4444", "selected-text-color": "#FFF4FA", "bold": true },
    "Error": { "text-color": "#EF4444", "selected-text-color": "#FFF4FA", "underline": true },
    "Others": { "text-color": "#B8AAB2", "selected-text-color": "#FFF4FA" }
  }
}
