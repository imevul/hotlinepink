{
  "name": "Hotline Pink",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#FFF4FA",
    "descriptionForeground": "#B8AAB2",
    "errorForeground": "#EF4444",
    "focusBorder": "#2DE2E6",
    "selection.background": "#49313E",
    "textLink.foreground": "#FF5CB8",
    "textLink.activeForeground": "#FF1493",
    "editor.background": "#09090B",
    "editor.foreground": "#FFF4FA",
    "editorCursor.foreground": "#FF1493",
    "editor.lineHighlightBackground": "#121214",
    "editor.selectionBackground": "#49313E",
    "editor.findMatchBackground": "#C6006F",
    "editor.findMatchHighlightBackground": "#49313E",
    "editorLineNumber.foreground": "#8E7985",
    "editorLineNumber.activeForeground": "#FF1493",
    "editorIndentGuide.background1": "#2A1F26",
    "editorIndentGuide.activeBackground1": "#49313E",
    "editorBracketMatch.background": "#1C191C",
    "editorBracketMatch.border": "#FF1493",
    "editorBracketHighlight.foreground1": "#B8AAB2",
    "editorBracketHighlight.foreground2": "#FF5CB8",
    "editorBracketHighlight.foreground3": "#2DE2E6",
    "editorBracketHighlight.foreground4": "#B8AAB2",
    "editorBracketHighlight.foreground5": "#FF5CB8",
    "editorBracketHighlight.foreground6": "#2DE2E6",
    "editorBracketHighlight.unexpectedBracket.foreground": "#EF4444",
    "editorError.foreground": "#EF4444",
    "editorWarning.foreground": "#F59E0B",
    "editorInfo.foreground": "#2DE2E6",
    "editorGutter.addedBackground": "#22C55E",
    "editorGutter.modifiedBackground": "#F59E0B",
    "editorGutter.deletedBackground": "#EF4444",
    "editorGroupHeader.tabsBackground": "#121214",
    "editorWidget.background": "#121214",
    "editorWidget.border": "#49313E",
    "editorSuggestWidget.background": "#121214",
    "editorSuggestWidget.selectedBackground": "#1C191C",
    "editorSuggestWidget.highlightForeground": "#FF1493",
    "diffEditor.insertedTextBackground": "#12261A",
    "diffEditor.removedTextBackground": "#2B1416",
    "activityBar.background": "#09090B",
    "activityBar.foreground": "#FF1493",
    "activityBar.inactiveForeground": "#8E7985",
    "activityBar.border": "#2A1F26",
    "activityBarBadge.background": "#FF1493",
    "activityBarBadge.foreground": "#09090B",
    "sideBar.background": "#121214",
    "sideBar.foreground": "#B8AAB2",
    "sideBar.border": "#2A1F26",
    "sideBarTitle.foreground": "#FFF4FA",
    "sideBarSectionHeader.background": "#121214",
    "sideBarSectionHeader.foreground": "#FF1493",
    "list.activeSelectionBackground": "#1C191C",
    "list.activeSelectionForeground": "#FFF4FA",
    "list.inactiveSelectionBackground": "#1C191C",
    "list.hoverBackground": "#1C191C",
    "list.highlightForeground": "#FF1493",
    "tab.activeBackground": "#09090B",
    "tab.activeForeground": "#FFF4FA",
    "tab.activeBorderTop": "#FF1493",
    "tab.inactiveBackground": "#121214",
    "tab.inactiveForeground": "#B8AAB2",
    "tab.border": "#2A1F26",
    "titleBar.activeBackground": "#09090B",
    "titleBar.activeForeground": "#FFF4FA",
    "titleBar.inactiveBackground": "#09090B",
    "titleBar.inactiveForeground": "#8E7985",
    "titleBar.border": "#2A1F26",
    "statusBar.background": "#09090B",
    "statusBar.foreground": "#B8AAB2",
    "statusBar.border": "#2A1F26",
    "statusBar.noFolderBackground": "#09090B",
    "statusBar.debuggingBackground": "#C6006F",
    "statusBar.debuggingForeground": "#FFF4FA",
    "statusBarItem.remoteBackground": "#FF1493",
    "statusBarItem.remoteForeground": "#09090B",
    "panel.background": "#09090B",
    "panel.border": "#2A1F26",
    "panelTitle.activeForeground": "#FFF4FA",
    "panelTitle.activeBorder": "#FF1493",
    "panelTitle.inactiveForeground": "#B8AAB2",
    "button.background": "#FF1493",
    "button.foreground": "#09090B",
    "button.hoverBackground": "#FF5CB8",
    "badge.background": "#FF1493",
    "badge.foreground": "#09090B",
    "input.background": "#121214",
    "input.foreground": "#FFF4FA",
    "input.border": "#49313E",
    "input.placeholderForeground": "#8E7985",
    "dropdown.background": "#121214",
    "dropdown.border": "#49313E",
    "progressBar.background": "#FF1493",
    "gitDecoration.addedResourceForeground": "#22C55E",
    "gitDecoration.modifiedResourceForeground": "#F59E0B",
    "gitDecoration.deletedResourceForeground": "#EF4444",
    "gitDecoration.untrackedResourceForeground": "#2DE2E6",
    "gitDecoration.ignoredResourceForeground": "#8E7985",
    "terminal.background": "#09090B",
    "terminal.foreground": "#FFF4FA",
    "terminalCursor.foreground": "#FF1493",
    "terminal.selectionBackground": "#49313E",
    "terminal.ansiBlack": "#1C191C",
    "terminal.ansiRed": "#EF4444",
    "terminal.ansiGreen": "#22C55E",
    "terminal.ansiYellow": "#F59E0B",
    "terminal.ansiBlue": "#6E8BFF",
    "terminal.ansiMagenta": "#FF1493",
    "terminal.ansiCyan": "#2DE2E6",
    "terminal.ansiWhite": "#B8AAB2",
    "terminal.ansiBrightBlack": "#8E7985",
    "terminal.ansiBrightRed": "#FF7A7A",
    "terminal.ansiBrightGreen": "#4ADE80",
    "terminal.ansiBrightYellow": "#FBBF24",
    "terminal.ansiBrightBlue": "#A0B2FF",
    "terminal.ansiBrightMagenta": "#FF5CB8",
    "terminal.ansiBrightCyan": "#8AF3F5",
    "terminal.ansiBrightWhite": "#FFF4FA"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8E7985" } },
    { "scope": ["keyword", "storage", "storage.modifier", "keyword.control"], "settings": { "foreground": "#FF1493" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#FF5CB8" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "storage.type"], "settings": { "foreground": "#2DE2E6" } },
    { "scope": ["storage.type.function", "storage.type.class", "storage.type.struct", "storage.type.interface", "storage.type.enum"], "settings": { "foreground": "#FF1493" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#4ADE80" } },
    { "scope": ["constant", "constant.numeric", "constant.language"], "settings": { "foreground": "#F59E0B" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#FFF4FA" } },
    { "scope": ["punctuation", "keyword.operator"], "settings": { "foreground": "#B8AAB2" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#FF1493" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#FF5CB8" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#FF1493", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#FF5CB8" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#22C55E" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#EF4444" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#F59E0B" } },
    { "scope": ["invalid"], "settings": { "foreground": "#EF4444" } }
  ]
}
