<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key><string>Hotline Pink</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key><string>#09090B</string>
        <key>foreground</key><string>#FFF4FA</string>
        <key>caret</key><string>#FF1493</string>
        <key>lineHighlight</key><string>#1C191C</string>
        <key>selection</key><string>#49313E</string>
        <key>gutter</key><string>#09090B</string>
        <key>gutterForeground</key><string>#8E7985</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Comment</string>
      <key>scope</key><string>comment, punctuation.definition.comment</string>
      <key>settings</key><dict><key>foreground</key><string>#8E7985</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Keyword</string>
      <key>scope</key><string>keyword, storage, keyword.control, keyword.operator.word</string>
      <key>settings</key><dict><key>foreground</key><string>#FF1493</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Function</string>
      <key>scope</key><string>entity.name.function, support.function, meta.function-call variable.function</string>
      <key>settings</key><dict><key>foreground</key><string>#FF5CB8</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Type</string>
      <key>scope</key><string>entity.name.type, entity.name.class, support.type, support.class, storage.type</string>
      <key>settings</key><dict><key>foreground</key><string>#2DE2E6</string></dict>
    </dict>
    <dict>
      <key>name</key><string>String</string>
      <key>scope</key><string>string, punctuation.definition.string</string>
      <key>settings</key><dict><key>foreground</key><string>#4ADE80</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Number and constant</string>
      <key>scope</key><string>constant, constant.numeric, constant.language</string>
      <key>settings</key><dict><key>foreground</key><string>#F59E0B</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Variable</string>
      <key>scope</key><string>variable, variable.parameter</string>
      <key>settings</key><dict><key>foreground</key><string>#FFF4FA</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Punctuation</string>
      <key>scope</key><string>punctuation, keyword.operator</string>
      <key>settings</key><dict><key>foreground</key><string>#B8AAB2</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Tag</string>
      <key>scope</key><string>entity.name.tag</string>
      <key>settings</key><dict><key>foreground</key><string>#FF1493</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Attribute</string>
      <key>scope</key><string>entity.other.attribute-name</string>
      <key>settings</key><dict><key>foreground</key><string>#FF5CB8</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Markup heading</string>
      <key>scope</key><string>markup.heading, entity.name.section</string>
      <key>settings</key><dict><key>foreground</key><string>#FF1493</string><key>fontStyle</key><string>bold</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Markup link</string>
      <key>scope</key><string>markup.underline.link</string>
      <key>settings</key><dict><key>foreground</key><string>#FF5CB8</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Inserted</string>
      <key>scope</key><string>markup.inserted</string>
      <key>settings</key><dict><key>foreground</key><string>#22C55E</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Deleted</string>
      <key>scope</key><string>markup.deleted</string>
      <key>settings</key><dict><key>foreground</key><string>#EF4444</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Changed</string>
      <key>scope</key><string>markup.changed</string>
      <key>settings</key><dict><key>foreground</key><string>#F59E0B</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Invalid</string>
      <key>scope</key><string>invalid</string>
      <key>settings</key><dict><key>foreground</key><string>#EF4444</string></dict>
    </dict>
  </array>
</dict>
</plist>
